    <string name="onboarding_welcome_title">Welcome to %1$s</string>
    <string name="onboarding_welcome_text">Reminders straight from your Markdown notes. Write a task with a date, get an alarm on time.</string>
    <string name="onboarding_feature_markdown">Reads tasks with dates from your notes</string>
    <string name="onboarding_feature_offline">No internet permission. Nothing leaves your phone.</string>
    <string name="onboarding_feature_private">No account, no server, no tracking</string>
    <string name="onboarding_vault_title">Choose your vault</string>
    <string name="onboarding_vault_text">Pick the folder that contains your notes, for example Documents/MyVault.</string>
    <string name="onboarding_vault_detected">Obsidian vault detected</string>
    <string name="onboarding_vault_not_detected">No .obsidian folder found. Works anyway with any Markdown folder.</string>
    <string name="onboarding_vault_name_hint">Used for links that open notes in Obsidian. Must match the vault name in Obsidian.</string>
    <string name="onboarding_vault_error">This folder cannot be read. Please choose another one. Android blocks folders inside Android/data for other apps.</string>
    <string name="onboarding_vault_why">Android grants access to this one folder only. The app writes to notes only if you enable \"Write done to note\" later.</string>
    <string name="onboarding_vault_android_data">Vaults inside Android/data, such as the app folder of Obsidian, cannot be opened by other apps. Keep the vault in a normal folder like Documents/.</string>
    <string name="onboarding_notifications_title">Allow notifications</string>
    <string name="onboarding_notifications_text">Reminders appear as notifications, with actions for done and snooze.</string>
    <string name="onboarding_notifications_why">Without this permission the app can still index your notes, but it cannot alert you.</string>
    <string name="onboarding_exact_title">Exact alarms</string>
    <string name="onboarding_exact_text">Since Android 14 apps need your approval to ring at an exact minute. Turn on the switch on the next screen and come back.</string>
    <string name="onboarding_exact_fallback">Without approval reminders still work, but Android may delay them by several minutes.</string>
    <string name="onboarding_exact_why">Exact alarms only wake the phone at the times in your notes. They do not drain the battery.</string>
    <string name="onboarding_done_title">All set</string>
    <string name="onboarding_done_text">Your vault is scanned now and every 30 minutes. Pull down on the list to scan any time.</string>
