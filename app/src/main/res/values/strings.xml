    <string name="privacy_title">Privacy</string>
    <string name="privacy_short">No internet permission, no data collection</string>
    <string name="privacy_intro">%1$s collects no data. There is nothing to send and no way to send it.</string>
    <string name="privacy_no_internet_title">No internet permission</string>
    <string name="privacy_no_internet_text">The app cannot open network connections. You can verify this in the system app info.</string>
    <string name="privacy_no_account_title">No account, no tracking</string>
    <string name="privacy_no_account_text">No sign-up, no analytics, no ads, no Google Play Services.</string>
    <string name="privacy_saf_title">Access to one folder only</string>
    <string name="privacy_saf_text">Android grants access only to the vault folder you chose. You can revoke it at any time.</string>
    <string name="privacy_local_title">Stays on your phone</string>
    <string name="privacy_local_text">The reminder index and settings are stored locally and excluded from cloud backups.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_text">Notifications, exact alarms, start after reboot, vibration and the request to be exempt from battery optimization. Nothing else.</string>
