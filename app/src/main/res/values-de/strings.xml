    <string name="privacy_title">Datenschutz</string>
    <string name="privacy_short">Keine Internet-Berechtigung, keine Datensammlung</string>
    <string name="privacy_intro">%1$s sammelt keine Daten. Es gibt nichts zu senden und keinen Weg, etwas zu senden.</string>
    <string name="privacy_no_internet_title">Keine Internet-Berechtigung</string>
    <string name="privacy_no_internet_text">Die App kann keine Netzwerkverbindung aufbauen. Das kannst du in den App-Infos des Systems prüfen.</string>
    <string name="privacy_no_account_title">Kein Konto, kein Tracking</string>
    <string name="privacy_no_account_text">Keine Anmeldung, keine Analyse, keine Werbung, keine Google Play Services.</string>
    <string name="privacy_saf_title">Zugriff nur auf einen Ordner</string>
    <string name="privacy_saf_text">Android gibt nur den Vault-Ordner frei, den du gewählt hast. Du kannst das jederzeit widerrufen.</string>
    <string name="privacy_local_title">Bleibt auf deinem Handy</string>
    <string name="privacy_local_text">Index und Einstellungen liegen lokal und sind von Cloud-Backups ausgeschlossen.</string>
    <string name="privacy_permissions_title">Berechtigungen</string>
    <string name="privacy_permissions_text">Benachrichtigungen, exakte Alarme, Start nach Neustart, Vibration und die Anfrage zur Akku-Ausnahme. Sonst nichts.</string>
